---
layout: layouts/base.liquid
---
{%- assign L = lang | default: 'it' -%}
{%- assign t = i18n.ui[L] -%}
{%- comment -%} lo stesso layout serve le circolari e gli atti normativi senza testo interattivo (content/normativa/) {%- endcomment -%}
{%- if sezione == 'normativa' -%}
  {%- assign indice = '/norme-italiane.html' -%}{%- assign indiceNome = t.normativa -%}{%- assign indiceBack = t.tuttaNormativa -%}
{%- else -%}
  {%- assign indice = '/circolari.html' -%}{%- assign indiceNome = t.circolari -%}{%- assign indiceBack = t.tutteCircolari -%}
{%- endif -%}
{%- comment -%} Dati strutturati della scheda: Article + BreadcrumbList (il filtro json fa l'escape) {%- endcomment -%}
{%- capture schedaHeadline %}{{ ente }}, {{ page.date | data: L }}{% endcapture -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": {{ schedaHeadline | json }},
      "datePublished": "{{ page.date | date: '%Y-%m-%d' }}",
      "inLanguage": "{{ L }}",
      "mainEntityOfPage": "{{ site.url }}{{ page.url }}",
      "publisher": { "@id": "{{ site.url }}/#organization" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "{{ t.home }}", "item": "{{ site.url }}{{ '/' | langUrl: L }}" },
        { "@type": "ListItem", "position": 2, "name": "{{ indiceNome }}", "item": "{{ site.url }}{{ indice | langUrl: L }}" },
        { "@type": "ListItem", "position": 3, "name": {{ schedaHeadline | json }} }
      ]
    }
  ]
}
</script>
<section class="bg-off-white" style="padding: 2rem 0 1rem;">
  <div class="container" style="max-width: 820px;">
    <a href="{{ indice | langUrl: L | url }}" class="scheda-back">{{ indiceBack }}</a>
    <div class="scheda-head">
      {% if esempio %}<span class="scheda-esempio">{{ t.esempio }}</span>{% endif %}
      <p class="scheda-kicker">{{ tipo | default: t.circolareDefault }}{% if numero %} · {{ numero }}{% endif %}</p>
      <h1 class="scheda-title">{{ ente }}, {{ page.date | data: L }}</h1>
      {% if temi %}
      <div class="scheda-temi">
        {% for tema in temi %}{% if sezione == 'normativa' %}<span class="scheda-tema">{{ tema | temaLabel: L }}</span>{% else %}<a class="scheda-tema" href="{{ '/circolari.html' | langUrl: L | url }}?tema={{ tema | temaSlug }}">{{ tema | temaLabel: L }}</a>{% endif %}{% endfor %}
      </div>
      {% endif %}
    </div>
  </div>
</section>

<section class="section" style="padding-top: 1.5rem;">
  <div class="container" style="max-width: 820px;">

    {% if t.avvisoTraduzione != "" %}<p class="scheda-avviso-traduzione">{{ t.avvisoTraduzione }}</p>{% endif %}
    <!--norme:on{% if norme_impliciti == false %} impliciti=off{% endif %}-->
    {% if oggetto %}
    <div class="scheda-massima">
      <p class="scheda-massima-label">{{ t.oggetto }}</p>
      <p>{{ oggetto }}</p>
    </div>
    {% endif %}

    <div class="scheda-body">
      {{ content }}
    </div>
    <!--norme:off-->

    {% if norme %}
    <div class="scheda-norme">
      <p class="scheda-norme-label">{{ t.normeCollegate }}</p>
      <ul>
        {% for n in norme %}
        {%- comment -%} le schede del sito (es. d.l. 100/2026) nella lingua della pagina; i testi interattivi restano in italiano {%- endcomment -%}
        <li><a href="{% if n.href contains '/patto-interattivo/' %}{{ n.href | url }}{% else %}{{ n.href | langUrl: L | url }}{% endif %}">{{ n.label }}</a></li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    {% if pdf %}
    <p style="margin-top: 2rem;">
      <a href="{{ pdf | url }}" class="scheda-pdf-btn" target="_blank" rel="noopener">📄 {{ pdfLabel | default: t.pdfDocumento }}</a>
    </p>
    {% endif %}

    {% if allegati %}
    <div class="scheda-allegati">
      <p class="scheda-norme-label">{{ t.allegati }}</p>
      <ul>
        {% for a in allegati %}
        <li><a href="{{ a.href | url }}" target="_blank" rel="noopener">📎 {{ a.label }}</a></li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

  </div>
</section>
<script src="{{ '/src/scripts/norme-hover.js' | url }}?v={{ site.assetVersion }}" defer></script>
